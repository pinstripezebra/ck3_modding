the_spark = {
	category = physical
	physical = yes
	genetic = yes
	good = yes
	icon = the_spark.dds
	learning = 1
	prowess = 1
	life_expectancy = 5

	ruler_designer_cost = 12

	on_add = {
		wizard_update_mana_gain = yes
		if = {
			limit = { NOT = { has_global_variable = wizard_mana_start_year } }
			set_global_variable = { name = wizard_mana_start_year value = current_year }
		}
	}
	on_remove = {
		wizard_update_mana_gain = yes
	}
}

