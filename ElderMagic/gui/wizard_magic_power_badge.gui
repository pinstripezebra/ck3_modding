# Floating magic power badge — scripted widget, no window_character.gui override needed.
# Uses datacontext to resolve Character scope; button overlay handles the tooltip.
window = {
	name = "wizard_magic_power_badge"
	layer = top
	parentanchor = top|left
	position = { 462 316 }
	size = { 120 26 }
	movable = no
	allow_outside = yes
	datacontext = "[CharacterWindow.GetCharacter]"

	# hide_bottom_left_HUD gates to "a sidebar is open"; Character.IsValid + power>0 gates to "it's a wizard"
	visible = "[And( GetVariableSystem.Exists('hide_bottom_left_HUD'), And( Character.IsValid, GreaterThan_CFixedPoint( Character.MakeScope.ScriptValue('wizard_total_magic_power'), '(CFixedPoint)0' ) ) )]"

	background = {
		using = Background_Area_Dark
	}

	hbox = {
		parentanchor = left|vcenter
		widgetanchor = left|vcenter
		margin = { 4 0 }
		spacing = 4

		icon = {
			size = { 18 18 }
			parentanchor = vcenter
			texture = "gfx/interface/icons/traits/mana_flame_small.dds"
		}

		text_single = {
			parentanchor = vcenter
			fontsize = 16
			default_format = "#color:{0.45,0.8,1.0,1.0}"
			align = nobaseline
			autoresize = yes
			raw_text = "[Character.MakeScope.ScriptValue('wizard_total_magic_power')]"
		}
	}

	# Invisible button overlay provides tooltip — same pattern as wizard_mana_bar.gui
	button = {
		parentanchor = center
		widgetanchor = center
		size = { 120 26 }
		using = tooltip_ne
		tooltipwidget = { wizard_magic_power_breakdown = {} }
	}
}
