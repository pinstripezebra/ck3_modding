# Floating magic power badge — scripted widget, no window_character.gui override needed.
# Only visible when the character window has a valid wizard character (magic power > 0).
window = {
	name = "wizard_magic_power_badge"
	layer = top
	parentanchor = top|left
	position = { 462 316 }
	size = { 120 26 }
	movable = no
	allow_outside = yes
	mousetransparent = yes

	visible = "[And( CharacterWindow.GetCharacter.IsValid, GreaterThan_CFixedPoint( CharacterWindow.GetCharacter.MakeScope.ScriptValue('wizard_total_magic_power'), '(CFixedPoint)0' ) )]"

	background = {
		using = Background_Area_Dark
	}

	hbox = {
		parentanchor = left|vcenter
		widgetanchor = left|vcenter
		margin = { 4 0 }
		spacing = 4

		icon = {
			size = { 18 18 }
			parentanchor = vcenter
			texture = "gfx/interface/icons/traits/mana_flame_small.dds"
		}

		text_single = {
			parentanchor = vcenter
			fontsize = 16
			default_format = "#color:{0.45,0.8,1.0,1.0}"
			align = nobaseline
			autoresize = yes
			raw_text = "[CharacterWindow.GetCharacter.MakeScope.ScriptValue('wizard_total_magic_power')]"
			tooltipwidget = { wizard_magic_power_breakdown = {} }
		}
	}
}
